{
  "name": "mcp-media-9router",
  "version": "0.1.0",
  "description": "MCP server for structured web intelligence through the 9router proxy.",
  "type": "module",
  "bin": {
    "mcp-media-9router": "dist/index.js",
    "mm9": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "uninstall.sh"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "mm9": "tsx src/cli.ts",
    "lint": "eslint .",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-search",
    "web-fetch",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.1.10"
  }
}
